<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".MedTrackApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MedTrack">

        <activity
            android:name=".local.entity.PatientEntity.kt"
            android:exported="false"
            android:label="@string/title_activity_patient_entity.kt"
            android:theme="@style/Theme.MedTrack" />

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:label="Log In"
            android:theme="@style/Theme.MedTrack" />
        <activity
            android:name=".SymptomsActivity"
            android:exported="false"
            android:label="@string/title_activity_symptomsscreen"
            android:theme="@style/Theme.MedTrack" />
        <activity
            android:name=".AddMedicationActivity"
            android:exported="false"
            android:label="@string/title_activity_addmedicationscreen"
            android:theme="@style/Theme.MedTrack" />
        <activity
            android:name=".HomeActivity"
            android:exported="false"
            android:label="@string/title_activity_homescreen"
            android:theme="@style/Theme.MedTrack" />
        <activity
            android:name=".SignUpActivity"
            android:exported="false"
            android:label="@string/title_activity_signupscreen"
            android:theme="@style/Theme.MedTrack" /> <!-- <activity -->
        <!-- android:name=".WelcomeActivity" -->
        <!-- android:exported="false" -->
        <!-- android:label="@string/title_activity_welcomescreen" -->
        <!-- android:theme="@style/Theme.MedTrack" /> -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MedTrack">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>